# 复制为 .env 后填写；.env 和运行数据不会提交到 Git。
# 每项密码、密钥分别运行一次 openssl rand -hex 32 生成并固定保存。
# 数据库和 Redis 密码使用十六进制，避免 URI 特殊字符转义问题。

# 必填：本仓库已发布的固定版本镜像或镜像摘要。
# 上游 calciumion/new-api 镜像不包含本仓库的二次开发修改。
# 不使用 latest，升级时明确更换版本并先备份。
NEW_API_IMAGE=

# 应用端口默认监听宿主机所有 IPv4 接口。
BIND_HOST=0.0.0.0
SERVER_PORT=3000
TZ=Asia/Shanghai
NODE_NAME=new-api-node-1
DEFAULT_LANGUAGE=zh-CN

# PostgreSQL 15；首次初始化后不要只修改 .env 来改库名、用户或密码。
POSTGRES_IMAGE=postgres:15
POSTGRES_USER=newapi
POSTGRES_DB=new-api
POSTGRES_PASSWORD=

# Redis 7；已在 Compose 中开启 AOF 持久化。
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=

# 固定保存并纳入私密备份；不要在重建或升级容器时重新生成。
SESSION_SECRET=
CRYPTO_SECRET=

# 必填：控制台的实际 HTTPS Origin，如 https://api.example.com。
# 多个 Origin 用英文逗号分隔，不能包含路径或通配符。
SESSION_COOKIE_TRUSTED_URL=

# 必填：New API 实际看到的反向代理源 IP/CIDR，不是浏览器客户端 IP。
# 参考 README 配置；不使用代理时填写 none。
TRUSTED_PROXIES=

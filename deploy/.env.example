# new-api-orange 部署环境变量
#
# 由 deploy/install.sh 自动生成 .env，也可手工复制本文件后修改。
# 所有值都是 compose 插值变量，不要加引号。

# Compose 项目名，决定容器名前缀
COMPOSE_PROJECT_NAME=new-api-orange

# 应用镜像，可改成指定版本或 digest
NEW_API_IMAGE=ghcr.io/juziool/new-api-orange:latest

# 监听地址和端口
BIND_HOST=0.0.0.0
HTTP_PORT=3000

# PostgreSQL
POSTGRES_USER=newapi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=newapi
POSTGRES_IMAGE_TAG=15-alpine

# Redis（只做缓存，不落盘）
REDIS_PASSWORD=change_me
REDIS_IMAGE_TAG=7-alpine

# 会话和缓存签名密钥，迁移时必须保持不变
SESSION_SECRET=change_me

# 加密密钥，留空则自动使用 SESSION_SECRET；设置后同样必须保持不变
# CRYPTO_SECRET=

# 其他
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1
SYNC_FREQUENCY=60

# 反向代理 / HTTPS（由你自己的 Nginx、Caddy 处理证书）
FRONTEND_BASE_URL=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# 备份保留份数
BACKUP_KEEP=7
